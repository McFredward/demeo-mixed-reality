[COLOR]
R=0
G=255
B=0

[TABLE]
Disable=true

[STEAMLINK]
; Effective only on a detected Steam Frame connected through Steam Link.
; Other headsets/transports automatically use the colour-key background.
NativePassthrough=true
; Auto prefers SteamVR OpenXR alpha blending when supported.
; SteamVR forces that path; LegacyCompanion retains the original PC/Frame companion.
Backend=Auto
; Legacy companion only: include mask traffic in the sender video budget.
AccountMaskBandwidth=true

[LOGGING]
; Auto uses the embedded build default: dev=Debug, main=Important.
; Overrides: Debug, Important, Warning, Error.
Level=Auto
