<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>SteamVrAlphaInteropChecks.packages.lock.json</NuGetLockFilePath>
    <OutputPath>bin/SteamVrAlpha/</OutputPath>
    <IntermediateOutputPath>obj/SteamVrAlpha/</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../SteamVrAlpha.cs;SteamVrAlphaInteropChecks.cs" />
    <PackageReference Include="Lib.Harmony" Version="[2.4.2]" />
  </ItemGroup>
</Project>
